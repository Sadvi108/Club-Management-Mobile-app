# Copy to .env. EXPO_PUBLIC_* are inlined at build time.

# Which Club.Api server the build starts on: prod | uat
# (switchable at runtime from the Server chips on the login screen)
#   prod = http://apimac.zyncbook.com      live academy data
#   uat  = https://apimacuat.zyncbook.com  same endpoints + the Boost gateway (/Bcpg)
EXPO_PUBLIC_API_ENV=uat

# Optional: point at a server that isn't in the list above. Adds a third "custom" option
# and makes it the default. Leave unset to use EXPO_PUBLIC_API_ENV.
# EXPO_PUBLIC_API_URL=

# Web preview only: routes browser API calls through the local CORS proxy (scripts/cors-proxy.js).
# The proxy also tolerates the UAT server's self-signed certificate, which browsers reject.
# Native builds ignore this and call the API directly.
EXPO_PUBLIC_WEB_API_PROXY=http://localhost:8082
